# Supabase DB 연결 (Session pooler — IPv4)
# 실제 값은 .env 파일에 넣으세요. .env 는 git에 커밋되지 않습니다.
# 비밀번호에 #, ! 등 특수문자가 있으면 반드시 큰따옴표로 감싸세요.
#   예) PGPASSWORD="p@ss#word!"
PGHOST=aws-1-ap-northeast-2.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.swlaeeklautolwzksitd
PGPASSWORD="your-password-here"
PGDATABASE=postgres

# 로그인 세션 서명 키 (아무도 모르는 긴 랜덤 문자열)
#   생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ⚠️ PMO 프로젝트 관리(h9-pmo)와 반드시 같은 값이어야 계정/세션이 통합됩니다.

# ── 통합 계정 ────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=hnine.com
ADMIN_EMAIL=hyungjoon.lim@hnine.com

# ── 상단바 앱 전환 링크 ──────────────────────────────────────
MONTHLY_APP_URL=https://h9-monthly-profit.onrender.com
PMO_APP_URL=https://h9-pmo.onrender.com

# ── 회사 계정(Google) SSO — 선택 ─────────────────────────────
# OIDC_PROVIDER=google
# OIDC_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxx

# (구버전 호환) 기존 단일 비밀번호. 최초 관리자 비밀번호 승계에만 쓰입니다.
# APP_PASSWORD="old-shared-password"
