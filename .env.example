# Supabase DB 연결 (Session pooler — IPv4)
# 실제 값은 .env 파일에 넣으세요. .env 는 git에 커밋되지 않습니다.
# 비밀번호에 #, ! 등 특수문자가 있으면 반드시 큰따옴표로 감싸세요.
#   예) PGPASSWORD="p@ss#word!"
PGHOST=aws-1-ap-northeast-2.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.swlaeeklautolwzksitd
PGPASSWORD="your-password-here"
PGDATABASE=postgres

# 로그인 세션 서명 키 (아무도 모르는 긴 랜덤 문자열)
#   생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# 앱 접근 비밀번호. 설정하면 로그인 없이는 접근 불가.
# 비우면 인증이 비활성화됩니다(개발용). 배포 시 반드시 설정하세요.
APP_PASSWORD="set-a-strong-password"
